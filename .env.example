# --- БОТ ---
# Токен бота из Discord Developer Portal (Bot -> Reset Token)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# --- БАЗА ДАННЫХ ---
# Строка подключения для Python-бота (использует пользователя ss14_bot)
DB_DSN=postgresql://ss14_bot:StrongPassword123!@127.0.0.1:5432/ss14

# --- КОНФИГУРАЦИЯ СЕРВЕРА ---
# ID твоего Discord-сервера (включи режим разработчика, ПКМ по серверу -> Копировать ID)
GUILD_ID=123456789012345678

# --- РОЛИ СПОНСОРОВ ---
# ID ролей, которые выдает Boosty (или ты вручную)
ROLE_TIER_1=111111111111111111
ROLE_TIER_2=222222222222222222
ROLE_TIER_3=333333333333333333

# --- СИНХРОНИЗАЦИЯ ---
# Поставь 1 для первого запуска (чтобы зарегистрировать команды /link и /unlink),
# после успешного запуска поменяй на 0.
SYNC_COMMANDS=1
